<article class="article-page section-pad" {{ section.shopify_attributes }}>
  <div class="page-width page-content__article">
    <p class="eyebrow">
      <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
    </p>
    <h1>{{ article.title | escape }}</h1>
    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d.%m.%Y' }}</time>
    {%- if article.image -%}
      <div class="article-page__hero">
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: article.image.alt }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{
  "name": "Artículo",
  "tag": "section",
  "class": "section-main-article"
}
{% endschema %}
