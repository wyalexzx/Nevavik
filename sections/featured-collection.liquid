{%- assign collection = section.settings.collection -%}
{%- assign limit = section.settings.products_to_show -%}

<section class="featured-collection section-pad" {{ section.shopify_attributes }}>
  <div class="section-heading page-width">
    <div>
      {%- if section.settings.kicker != blank -%}
        <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading__title">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading | escape }}
        {%- elsif collection != blank -%}
          {{ collection.title | escape }}
        {%- else -%}
          {{ 'onboarding.collection_title' | t }}
        {%- endif -%}
      </h2>
    </div>
    {%- if collection != blank -%}
      <a class="text-link" href="{{ collection.url }}">
        {{ 'collection.view_all' | t }}
        {% render 'icon', name: 'arrow' %}
      </a>
    {%- endif -%}
  </div>

  <div class="product-grid page-width">
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- for product in collection.products limit: limit -%}
        {% render 'product-card', card_product: product, index: forloop.index %}
      {%- endfor -%}
    {%- elsif collection != blank -%}
      <p class="placeholder-copy page-width">{{ 'collection.empty' | t }}</p>
    {%- else -%}
      <p class="onboarding-note">{{ 'onboarding.no_collection' | t }}</p>
      {%- for i in (1..4) -%}
        {% render 'product-card', card_product: empty, index: i %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Colección destacada",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Cintillo",
      "default": "[PLACEHOLDER]"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (vacío = nombre de la colección)"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección de Shopify"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Productos a mostrar",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Colección destacada"
    }
  ]
}
{% endschema %}
