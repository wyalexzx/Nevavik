<section class="hero{% if section.settings.full_height %} hero--tall{% endif %}" {{ section.shopify_attributes }}>
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '480, 750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          class: 'hero__img',
          alt: hero_alt
      }}
    {%- else -%}
      <div class="hero__placeholder">
        <span>{{ 'onboarding.no_image' | t }}</span>
      </div>
    {%- endif -%}
  </div>

  <div class="hero__copy page-width">
    {%- if section.settings.kicker != blank -%}
      <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    <h1 class="hero__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="hero__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- assign cta_primary_label = section.settings.cta_label | strip -%}
    {%- assign cta_secondary_label = section.settings.cta_secondary_label | strip -%}
    {%- assign cta_primary_key = cta_primary_label | downcase -%}
    {%- assign cta_secondary_key = cta_secondary_label | downcase -%}
    <div class="hero__actions">
      {%- if cta_primary_label != blank -%}
        <a class="btn btn--accent" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
          {{ cta_primary_label | escape }}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
      {%- if cta_secondary_label != blank and cta_secondary_key != cta_primary_key -%}
        <a class="btn btn--ghost" href="{{ section.settings.cta_secondary_link | default: routes.all_products_collection_url }}">
          {{ cta_secondary_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Campaña / hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de campaña"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Altura amplia",
      "default": true
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Cintillo",
      "default": "DROP 01 — COMING SOON"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Névavik"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Streetwear and training wear made for life beyond the gym."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA principal",
      "default": "Comprar"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace CTA principal"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "CTA secundario"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Enlace CTA secundario"
    }
  ],
  "presets": [
    {
      "name": "Campaña / hero"
    }
  ]
}
{% endschema %}
