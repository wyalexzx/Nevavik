{%- paginate search.results by 16 -%}
  <section class="search-page section-pad" {{ section.shopify_attributes }}>
    <div class="page-width">
      <h1>{{ 'search.title' | t }}</h1>
      <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <label class="visually-hidden" for="SearchPage">{{ 'search.placeholder' | t }}</label>
        <input id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <button class="btn btn--accent" type="submit">{{ 'search.submit' | t }}</button>
      </form>

      {%- if search.performed -%}
        {%- if search.results_count > 0 -%}
          <p>{{ 'search.results_with_count' | t: count: search.results_count, terms: search.terms }}</p>
          <div class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', card_product: item, index: forloop.index %}
              {%- else -%}
                <article class="product-card">
                  <div class="product-card__meta">
                    <h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                  </div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p>{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Búsqueda",
  "tag": "section",
  "class": "section-main-search"
}
{% endschema %}
