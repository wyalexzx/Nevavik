<footer class="site-footer" {{ section.shopify_attributes }}>
  <div class="site-footer__grid page-width">
    <div class="site-footer__brand">
      <p class="eyebrow">{% render 'brand-name' %}</p>
      <p class="site-footer__heading">{{ section.settings.heading | escape }}</p>
    </div>

    <div>
      <h2 class="site-footer__label">{{ 'footer.explore' | t }}</h2>
      {%- if section.settings.menu != blank -%}
        <ul class="site-footer__links">
          {%- for link in section.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="placeholder-copy">[PLACEHOLDER]</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_policies -%}
      <div>
        <h2 class="site-footer__label">{{ 'footer.policies' | t }}</h2>
        <ul class="site-footer__links">
          {%- assign policy_count = 0 -%}
          {%- for policy in shop.policies -%}
            {%- if policy.body != blank or policy.url != blank -%}
              {%- assign policy_count = policy_count | plus: 1 -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
          {%- if policy_count == 0 -%}
            <li class="placeholder-copy">[PLACEHOLDER]</li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.show_social -%}
      <div>
        <h2 class="site-footer__label">{{ 'footer.social' | t }}</h2>
        {% render 'social-icons' %}
      </div>
    {%- endif -%}
  </div>
  <div class="site-footer__legal page-width">
    {%- assign copyright_year = 'now' | date: '%Y' -%}
    {%- assign brand_name = 'general.shop_name' | t -%}
    <p>{{ 'footer.copyright' | t: year: copyright_year, shop_name: brand_name }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Texto de marca",
      "default": "[PLACEHOLDER]"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú del pie",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Mostrar políticas de Shopify",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Mostrar redes",
      "default": true
    }
  ]
}
{% endschema %}
