<section class="spotlight section-pad" {{ section.shopify_attributes }}>
  <div class="section-heading page-width">
    <div>
      {%- if section.settings.kicker != blank -%}
        <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 class="section-heading__title">{{ section.settings.heading | escape }}</h2>
    </div>
  </div>

  <div class="spotlight__grid page-width">
    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <article class="spotlight-card" {{ block.shopify_attributes }}>
        {%- if collection != blank -%}
          <a class="spotlight-card__link" href="{{ collection.url }}">
            <div class="spotlight-card__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 900px) 33vw, 100vw', alt: collection.title
                }}
              {%- elsif collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 1400
                  | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 900px) 33vw, 100vw', alt: collection.title
                }}
              {%- else -%}
                <span class="media-frame__placeholder">{{ 'onboarding.no_image' | t }}</span>
              {%- endif -%}
            </div>
            <div class="spotlight-card__body">
              <span class="spotlight-card__index" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
              <h3>{{ collection.title | escape }}</h3>
              <p>{{ block.settings.label | escape }}</p>
            </div>
          </a>
        {%- else -%}
          <div class="spotlight-card__link spotlight-card__link--empty">
            <div class="spotlight-card__media">
              <span class="media-frame__placeholder">{{ 'onboarding.no_image' | t }}</span>
            </div>
            <div class="spotlight-card__body">
              <h3>{{ 'onboarding.collection_title' | t }}</h3>
              <p>{{ 'onboarding.no_collection' | t }}</p>
            </div>
          </div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Focos de colección",
  "tag": "section",
  "class": "section-collection-spotlight",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Cintillo",
      "default": "[PLACEHOLDER]"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "[PLACEHOLDER]"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección de Shopify"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen (opcional; si no, imagen de la colección)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "CTA",
          "default": "Comprar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Focos de colección",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
