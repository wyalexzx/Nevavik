<section class="rich-text section-pad" {{ section.shopify_attributes }}>
  <div class="rich-text__inner page-width">
    {%- if section.settings.kicker != blank -%}
      <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="rich-text__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte rich-text__body">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn--accent" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_label | escape }}
        {% render 'icon', name: 'arrow' %}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Texto de marca",
  "tag": "section",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Cintillo",
      "default": "[PLACEHOLDER]"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "[PLACEHOLDER]"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>[PLACEHOLDER]</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA",
      "default": "Comprar"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace CTA"
    }
  ],
  "presets": [
    {
      "name": "Texto de marca"
    }
  ]
}
{% endschema %}
