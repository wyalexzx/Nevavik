<section class="password-page" {{ section.shopify_attributes }}>
  <div class="password-page__inner page-width">
    <p class="eyebrow">{% render 'brand-name' %}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p>{{ section.settings.text | escape }}</p>
    {%- form 'storefront_password', class: 'password-form' -%}
      {%- if form.errors -%}
        <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <label for="Password">{{ 'password.password' | t }}</label>
      <input type="password" name="password" id="Password" required>
      <button class="btn btn--accent" type="submit">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contraseña",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "[PLACEHOLDER]"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "[PLACEHOLDER]"
    }
  ]
}
{% endschema %}
