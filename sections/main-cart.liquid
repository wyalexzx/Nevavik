<section class="cart-page section-pad" {{ section.shopify_attributes }}>
  <div class="page-width">
    <header class="cart-page__header">
      <p class="eyebrow">{% render 'brand-name' %}</p>
      <h1>{{ 'cart.title' | t }}</h1>
    </header>

    {%- if cart.item_count == 0 -%}
      <p>{{ 'cart.empty' | t }}</p>
      <a class="btn btn--accent" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    {%- else -%}
      {%- form 'cart', cart, class: 'cart-form' -%}
        <ul class="cart-lines">
          {%- for item in cart.items -%}
            <li class="cart-line">
              <a class="cart-line__media" href="{{ item.url }}">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="cart-line__info">
                <a href="{{ item.url }}"><strong>{{ item.product.title | escape }}</strong></a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__variant">{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                <p>{{ item.original_price | money }}</p>
                <label class="visually-hidden" for="Updates-{{ item.key }}">{{ 'cart.quantity' | t }}</label>
                <div class="qty-field__controls qty-field__controls--compact">
                  <input
                    id="Updates-{{ item.key }}"
                    type="number"
                    name="updates[{{ item.key }}]"
                    value="{{ item.quantity }}"
                    min="0"
                  >
                </div>
                <a class="text-link" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>
              <p class="cart-line__total">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.show_note -%}
          <label class="cart-note" for="CartNote">{{ 'cart.note' | t }}</label>
          <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
        {%- endif -%}

        <div class="cart-summary">
          <div class="cart-summary__row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="cart-summary__hint">{{ 'cart.taxes_shipping' | t }}</p>
          <div class="cart-summary__actions">
            <button class="btn btn--ghost" type="submit" name="update">{{ 'cart.update' | t }}</button>
            <button class="btn btn--accent" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carrito",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Mostrar nota del pedido",
      "default": true
    }
  ]
}
{% endschema %}
