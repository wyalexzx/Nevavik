{%- if section.settings.text != blank -%}
  <div class="announcement" {{ section.shopify_attributes }}>
    {%- if section.settings.link != blank -%}
      <a class="announcement__link" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      <p class="announcement__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de aviso",
  "tag": "section",
  "class": "section-announcement",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "default": "[PLACEHOLDER]"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace (opcional)"
    }
  ]
}
{% endschema %}
