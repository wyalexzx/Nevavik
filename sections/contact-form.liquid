<section class="contact-section section-pad" {{ section.shopify_attributes }}>
  <div class="page-width contact-section__grid">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status" tabindex="-1">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="form-status form-status--error" tabindex="-1">
          {{ 'contact.error' | t }}
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <label for="ContactName">{{ 'contact.name' | t }}</label>
      <input type="text" id="ContactName" name="contact[name]" required autocomplete="name">

      <label for="ContactEmail">{{ 'contact.email' | t }}</label>
      <input type="email" id="ContactEmail" name="contact[email]" required autocomplete="email">

      <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
      <input type="tel" id="ContactPhone" name="contact[phone]" autocomplete="tel">

      <label for="ContactBody">{{ 'contact.message' | t }}</label>
      <textarea id="ContactBody" name="contact[body]" rows="6" required></textarea>

      <button class="btn btn--accent" type="submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Formulario de contacto",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "[PLACEHOLDER]"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>[PLACEHOLDER]</p>"
    }
  ],
  "presets": [
    {
      "name": "Formulario de contacto"
    }
  ]
}
{% endschema %}
