{%- comment -%}
  Product card from a Shopify product object. Never hardcodes prices.
  Accepts: card_product, index (optional)
{%- endcomment -%}
{%- if card_product and card_product != empty -%}
  <article class="product-card">
    <a class="product-card__media media-frame media-frame--{{ settings.card_image_ratio }}" href="{{ card_product.url }}">
      {%- if card_product.featured_media -%}
        {%- assign card_alt = card_product.featured_media.alt | default: card_product.title -%}
        {{
          card_product.featured_media
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '320, 480, 720, 900',
            sizes: '(min-width: 750px) 30vw, 90vw',
            alt: card_alt
        }}
      {%- else -%}
        <span class="media-frame__placeholder" aria-hidden="true">{{ 'onboarding.no_image' | t }}</span>
      {%- endif -%}
      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="product-card__badge">{{ 'product.on_sale' | t }}</span>
      {%- endif -%}
      {%- if index -%}
        <span class="product-card__index" aria-hidden="true">{{ index | prepend: '00' | slice: -2, 2 }}</span>
      {%- endif -%}
    </a>
    <div class="product-card__meta">
      <h3 class="product-card__title">
        <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
      </h3>
      {% render 'price', product: card_product %}
    </div>
  </article>
{%- else -%}
  <article class="product-card product-card--placeholder">
    <div class="product-card__media media-frame media-frame--{{ settings.card_image_ratio }}">
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
    <div class="product-card__meta">
      <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
      <p class="placeholder-copy">{{ 'general.placeholder' | t }}</p>
    </div>
  </article>
{%- endif -%}
