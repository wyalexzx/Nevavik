{%- if paginate.pages > 1 -%}
  <nav class="pagination" role="navigation" aria-label="{{ 'general.meta.page' | t: page: paginate.current_page }}">
    <ul class="pagination__list">
      {%- if paginate.previous -%}
        <li>
          <a class="pagination__link" href="{{ paginate.previous.url }}" aria-label="{{ 'accessibility.previous' | t }}">
            {{ 'accessibility.previous' | t }}
          </a>
        </li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            <span class="pagination__link pagination__link--current"{% if part.title == paginate.current_page %} aria-current="page"{% endif %}>{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li>
          <a class="pagination__link" href="{{ paginate.next.url }}" aria-label="{{ 'accessibility.next' | t }}">
            {{ 'accessibility.next' | t }}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
